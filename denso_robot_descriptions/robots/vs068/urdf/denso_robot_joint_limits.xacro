			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">1</param>
			</command_interface>
                        <state_interface name="position">
                                <param name="initial_value">0.000000</param>
                        </state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_4">
			<command_interface name="position">
				<param name="min">-4.712389</param>
				<param name="max">4.712389</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">1</param>
			</command_interface>
                        <state_interface name="position">
                                <param name="initial_value">0.000000</param>
                        </state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_5">
			<command_interface name="position">
				<param name="min">-2.094395</param>
				<param name="max">2.094395</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">1</param>
			</command_interface>
                        <state_interface name="position">
                                <param name="initial_value">0.000000</param>
                        </state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_6">
			<command_interface name="position">
				<param name="min">-6.283185</param>
				<param name="max">6.283185</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">1</param>
			</command_interface>
                        <state_interface name="position">
                                <param name="initial_value">0.000000</param>
                        </state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
	</xacro:macro>
</robot>
