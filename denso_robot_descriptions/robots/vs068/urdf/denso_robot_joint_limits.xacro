<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:macro name="denso_robot_control_limits" params="namespace">
		<joint name="$(arg namespace)joint_1">
			<command_interface name="position">
				<param name="min">-2.967060</param>
				<param name="max">2.967060</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">1</param>
			</command_interface>
                        <state_interface name="position">
                                <param name="initial_value">0.000000</param>
                        </state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_2">
			<command_interface name="position">
				<param name="min">-1.745329</param>
				<param name="max">2.356194</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">1</param>
			</command_interface>
                        <state_interface name="position">
                                <param name="initial_value">0.000000</param>
                        </state_interface>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_3">
